      "source": [
        "def perceptron(input_shape= [1], units= 1, activation= None):\n",
        "    model = keras.Sequential(\n",
        "        [\n",
        "            keras.layers.Input(shape= input_shape),\n",
        "            keras.layers.Dense(units= units, activation= activation)\n",
        "        ]\n",
        "    )\n",
        "    return model\n",
        "\n",
        "linear_model = perceptron()\n",
        "\n",
