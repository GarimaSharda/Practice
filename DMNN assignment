      "source": [
        "# make sure x_train, y_train are the 1D regression data\n",
        "x_train = torch.linspace(0, 3, 50).numpy().reshape(-1, 1)\n",
        "y_train = (-torch.sin(0.8 * torch.linspace(0, 3, 50))).numpy().reshape(-1, 1)\n",
        "\n",
        "\n",
        "# Helper: function to reset and train the linear model\n",
        "def train_linear(lr, epochs):\n",
        "    model = perceptron()  # fresh model\n",
        "    model.compile(optimizer=keras.optimizers.SGD(learning_rate=lr),\n",
        "                  loss=\"mse\")\n",
        "    history = model.fit(x_train, y_train,\n",
        "                        batch_size=len(x_train),\n",
        "                        epochs=epochs,\n",
        "                        verbose=0)\n",
        "    return model, history.history[\"loss\"]\n",
        "\n",
        "# 1) Original learning rate (e.g. 0.01)\n",
        "model_lr1, loss_lr1 = train_linear(lr=0.01, epochs=35)\n",
        "\n",
        "# 2) Learning rate / 10\n",
        "model_lr2, loss_lr2 = train_linear(lr=0.001, epochs=35)\n",
        "\n",
