      "source": [
        "# Defining our dataset\n",
        "\n",
        "x_train = torch.linspace(0, 3, 50)\n",
        "y_train = - torch.sin(0.8*x_train)\n",
        "\n",
        "# Plotting the dataset\n",
        "\n",
        "plt.figure()\n",
        "plt.xlabel(\"x\")\n",
        "plt.ylabel(\"y\")\n",
